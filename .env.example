# Copy to .env and change before any shared or production deployment.
ENVIRONMENT=development
# Change both if port 3000 is already used on your machine
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000
POSTGRES_PASSWORD=app
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false

# Email for alerts, invitations and privacy-request confirmations (optional).
# Amazon SES (ap-south-1), Postmark, SendGrid or Google Workspace SMTP relay all work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Anupalan <no-reply@yourcompany.com>
