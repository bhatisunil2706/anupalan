# Copy to .env. Everything marked REQUIRED must be set for production
# (docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d refuses to start without them).
ENVIRONMENT=development
# Change both if port 3000 is already used on your machine
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000

# ---- Secrets (REQUIRED in production) ------------------------------------------------------------------
# Database owner (used only by the migrate container)
POSTGRES_PASSWORD=app
# Restricted runtime role the app connects as; row-level security applies to it
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNTIME_DB_PASSWORD=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Master key for credentials and evidence encryption (per-company keys are derived from it). Back it up
# separately from the database: without it, evidence can't be decrypted.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
COOKIE_SECURE=false

# ---- Production only -------------------------------------------------------------------------------
# Public host name served by Caddy with an automatic Let's Encrypt certificate
DOMAIN=
ACME_EMAIL=
# Passphrase for the encrypted daily backups (store it in your password manager)
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
LOG_FORMAT=json
# Bearer token for Prometheus scraping of the backend's /metrics
METRICS_TOKEN=

# ---- Evidence storage ------------------------------------------------------------------------------
# local (encrypted files in a Docker volume) or s3 (encrypted objects + SSE-KMS)
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_KMS_KEY_ID=
# Optional ClamAV daemon for scanning uploads, e.g. clamav:3310
CLAMAV_ADDRESS=

# ---- Email for alerts, invitations, password resets and verification -------------------------------
# Amazon SES (ap-south-1), Postmark, SendGrid or Google Workspace SMTP relay all work.
# For local testing: docker compose --profile mail up, then SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pramaanly <no-reply@yourcompany.com>
SMTP_STARTTLS=true

# ---- AI assistant (optional; each company's owner must also opt in) ---------------------------------
# AI_PROVIDER: anthropic | openai | azure_openai | gemini | openai_compatible (Ollama, vLLM, LM Studio, ...)
AI_PROVIDER=anthropic
AI_API_KEY=
# Required for every provider except anthropic (defaults to claude-sonnet-5-5); for Azure, the deployment name
AI_MODEL=
# Required for azure_openai (https://<resource>.openai.azure.com) and openai_compatible (e.g. http://ollama:11434/v1)
AI_BASE_URL=
